<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Map tiles (MapLibre via JNI HttpURLConnection) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ride telemetry (LocationManager via JNI; requested at runtime) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The dashboard still runs without a GPS radio (mock/demo mode). -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <application
        android:label="cyclomp"
        android:hasCode="false">
        <!-- We draw every pixel ourselves and ship no Android resources, so the
             activity handles ALL config changes in-process. A recreate would
             destroy the activity and end the process (see cyclomp_on_destroy),
             and the Slint runtime cannot start twice in one process. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|density|screenSize|smallestScreenSize|layoutDirection|colorMode">
            <meta-data
                android:name="android.app.lib_name"
                android:value="cyclomp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
