<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Map tiles (MapLibre via JNI HttpURLConnection) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ride telemetry (LocationManager via JNI; requested at runtime) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Ride selfies (NDK Camera2; requested at runtime). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Background ride recording: a foreground Service (RideService) lifts the
         API 26+ background-location throttle and drops the process kill score. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- The ongoing notification is mandatory for a foreground service; runtime
         permission on API 33+, requested at first ride start. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Not required: the computer is fully usable on a phone without one. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <!-- The dashboard still runs without a GPS radio (mock/demo mode). -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <application
        android:label="cyclomp"
        android:hasCode="true">
        <!-- We draw every pixel ourselves and ship no Android resources, so the
             activity handles ALL config changes in-process. A recreate would
             destroy the activity and end the process (see cyclomp_on_destroy),
             and the Slint runtime cannot start twice in one process. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|density|screenSize|smallestScreenSize|layoutDirection|colorMode">
            <meta-data
                android:name="android.app.lib_name"
                android:value="cyclomp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Keeps recording alive while the app is backgrounded. Not exported;
             started only from within the app over JNI (ride_service_android.cpp). -->
        <service
            android:name=".RideService"
            android:foregroundServiceType="location"
            android:exported="false" />
    </application>
</manifest>
