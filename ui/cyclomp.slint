// cyclomp — Bauhaus bike-computer dashboard (mock)
// Shared UI: renders on desktop (C++ preview) and Android (C++ NDK / Slint android-activity).

import { ListView } from "std-widgets.slint";

// ---- Bauhaus palette ----
global Palette {
    out property <color> ink: #0d0d0d;      // near-black background
    out property <color> paper: #f4f1e9;    // bone white
    out property <color> yellow: #f3c500;
    out property <color> red: #e2231a;
    out property <color> blue: #1457b8;
    out property <color> ash: #2a2a2a;      // panel fill
    out property <color> mute: #8a8a8a;
}

// A finished ride, provided by C++ (newest first).
export struct SessionRow {
    date: string,     // "07 SEP 14:32"
    dist: string,     // km, one decimal
    time: string,     // moving time mm:ss
    avg: string,      // km/h
    max: string,      // km/h
    cadence: string,  // rpm
    hr: string,       // bpm
}

// A metric tile: small label on top, big value, small unit.
component MetricTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <color> accent: Palette.paper;
    background: Palette.ash;
    VerticalLayout {
        padding: 12px;
        spacing: 2px;
        Text {
            text: root.label;
            color: Palette.mute;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 4px;
            Text {
                text: root.value;
                color: root.accent;
                font-size: 34px;
                font-weight: 900;
                vertical-alignment: center;
            }
            Text {
                text: root.unit;
                color: Palette.mute;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: bottom;
            }
        }
    }
}

// Turn-by-turn nav strip. Geometric arrow drawn with a Path.
component NavStrip inherits Rectangle {
    in property <string> instruction;
    in property <string> distance;
    background: Palette.yellow;
    height: 76px;
    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        alignment: start;
        // bold right-turn chevron
        Rectangle {
            width: 44px;
            height: 44px;
            y: (parent.height - self.height) / 2;
            Path {
                fill: Palette.ink;
                commands: "M 10 30 L 30 30 L 30 12 L 44 32 L 30 52 L 30 40 L 10 40 Z";
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 54; viewbox-height: 64;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.distance;
                color: Palette.ink;
                font-size: 20px;
                font-weight: 900;
            }
            Text {
                text: root.instruction;
                color: Palette.ink;
                font-size: 13px;
                font-weight: 700;
            }
        }
    }
}

// A bottom tab-bar item with a yellow active indicator.
component TabItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback pressed();
    background: root.active ? Palette.ash : Palette.ink;
    TouchArea {
        clicked => { root.pressed(); }
    }
    VerticalLayout {
        Rectangle {
            height: 4px;
            background: root.active ? Palette.yellow : transparent;
        }
        Text {
            text: root.label;
            color: root.active ? Palette.paper : Palette.mute;
            font-size: 14px;
            font-weight: 900;
            letter-spacing: 2px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A ride/pause/stop control button.
component ControlButton inherits Rectangle {
    in property <string> label;
    in property <color> fill: Palette.blue;
    in property <color> label-color: Palette.paper;
    callback pressed();
    background: touch.pressed ? Palette.ash : root.fill;
    touch := TouchArea {
        clicked => { root.pressed(); }
    }
    Text {
        text: root.label;
        color: root.label-color;
        font-size: 20px;
        font-weight: 900;
        letter-spacing: 2px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "cyclomp";
    background: Palette.ink;
    default-font-size: 15px;
    preferred-width: 400px;
    preferred-height: 860px;

    // ---- Live ride state (driven from C++) ----
    in-out property <float> speed: 0;        // km/h
    in-out property <string> distance: "0.0"; // km
    in-out property <string> ride-time: "00:00";
    in-out property <float> avg-speed: 0;
    in-out property <int> cadence: 0;         // rpm
    in-out property <int> heart-rate: 0;      // bpm
    in-out property <int> hr-zone: 0;         // 1..5
    in-out property <string> nav-distance: "400 m";
    in-out property <string> nav-instruction: "Turn right — Elm St";

    // Session lifecycle: 0 = idle, 1 = running, 2 = paused.
    in-out property <int> ride-state: 0;

    // Saved rides, newest first (C++ owns the model).
    in property <[SessionRow]> sessions;

    // 0 = live dashboard, 1 = map, 2 = history list.
    in-out property <int> screen: 0;
    in-out property <int> selected-session: -1;

    // ---- Map (rendered off-screen by MapLibre; C++ pushes RGBA frames) ----
    in property <image> map-frame;
    in property <bool> map-available: false;

    callback toggle-ride();  // idle->start, running->pause, paused->resume
    callback stop-ride();    // finalize + save session
    callback map-zoom(int);  // +1 / -1 zoom step
    callback map-pan(float, float);          // one-finger drag delta (px)
    callback map-pinch-begin();
    callback map-pinch(float, float, float); // cumulative scale, center x, y

    property <color> hr-color: root.hr-zone >= 4 ? Palette.red
                             : root.hr-zone == 3 ? Palette.yellow
                             : Palette.blue;

    // Safe-area insets: system status bar (top) and gesture/nav bar (bottom)
    // get their own dark strips so they stay visible over the black UI.
    in-out property <length> top-inset: 44px;
    in-out property <length> bottom-inset: 40px;

    VerticalLayout {
        // status-bar inset
        Rectangle {
            height: root.top-inset;
            background: Palette.ink;
        }

        // ================= DASHBOARD =================
        if root.screen == 0 : VerticalLayout {
            vertical-stretch: 1;
            NavStrip {
                instruction: root.nav-instruction;
                distance: root.nav-distance;
            }

            // ---- Speed hero ----
            Rectangle {
                vertical-stretch: 1;
                background: Palette.ink;
                VerticalLayout {
                    alignment: center;
                    spacing: 0px;
                    Text {
                        text: root.ride-state == 2 ? "PAUSED" : "SPEED  km/h";
                        color: root.ride-state == 2 ? Palette.yellow : Palette.mute;
                        font-size: 13px;
                        font-weight: 700;
                        letter-spacing: 2px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: Math.round(root.speed);
                        color: root.ride-state == 2 ? Palette.mute : Palette.paper;
                        font-size: 150px;
                        font-weight: 900;
                        horizontal-alignment: center;
                    }
                    // Bauhaus accent bar under the number
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            height: 8px;
                            width: 180px;
                            background: Palette.red;
                        }
                    }
                }
            }

            // ---- Core ride metrics row ----
            HorizontalLayout {
                spacing: 4px;
                padding-left: 4px;
                padding-right: 4px;
                MetricTile {
                    horizontal-stretch: 1;
                    label: "DIST";
                    value: root.distance;
                    unit: "km";
                    accent: Palette.yellow;
                }
                MetricTile {
                    horizontal-stretch: 1;
                    label: "TIME";
                    value: root.ride-time;
                    unit: "";
                    accent: Palette.paper;
                }
                MetricTile {
                    horizontal-stretch: 1;
                    label: "AVG";
                    value: Math.round(root.avg-speed);
                    unit: "km/h";
                    accent: Palette.paper;
                }
            }

            // ---- Cadence + heart rate ----
            HorizontalLayout {
                spacing: 4px;
                padding: 4px;
                MetricTile {
                    horizontal-stretch: 1;
                    label: "CADENCE";
                    value: root.cadence;
                    unit: "rpm";
                    accent: Palette.blue;
                }
                MetricTile {
                    horizontal-stretch: 1;
                    label: "HEART  Z\{root.hr-zone}";
                    value: root.heart-rate;
                    unit: "bpm";
                    accent: root.hr-color;
                }
            }

            // ---- Ride controls: START / PAUSE+STOP / RESUME+STOP ----
            HorizontalLayout {
                height: 64px;
                spacing: root.ride-state == 0 ? 0px : 4px;
                if root.ride-state == 0 : ControlButton {
                    horizontal-stretch: 1;
                    label: "START RIDE";
                    fill: Palette.blue;
                    pressed => { root.toggle-ride(); }
                }
                if root.ride-state != 0 : ControlButton {
                    horizontal-stretch: 1;
                    label: root.ride-state == 1 ? "PAUSE" : "RESUME";
                    fill: root.ride-state == 1 ? Palette.yellow : Palette.blue;
                    label-color: root.ride-state == 1 ? Palette.ink : Palette.paper;
                    pressed => { root.toggle-ride(); }
                }
                if root.ride-state != 0 : ControlButton {
                    horizontal-stretch: 1;
                    label: "STOP";
                    fill: Palette.red;
                    pressed => { root.stop-ride(); }
                }
            }
        }

        // ================= MAP =================
        if root.screen == 1 : Rectangle {
            vertical-stretch: 1;
            background: Palette.ink;

            if root.map-available : Image {
                width: 100%;
                height: 100%;
                source: root.map-frame;
                image-fit: cover;
            }

            // Gestures: one-finger pan, two-finger pinch zoom, double-tap
            // zoom-in. The zoom buttons are declared later, so they stay on
            // top and remain clickable.
            if root.map-available : ScaleRotateGestureHandler {
                started => { root.map-pinch-begin(); }
                updated => {
                    root.map-pinch(self.scale,
                                   self.center.x / 1px, self.center.y / 1px);
                }
                TouchArea {
                    property <length> last-x;
                    property <length> last-y;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            last-x = self.mouse-x;
                            last-y = self.mouse-y;
                        }
                    }
                    moved => {
                        root.map-pan((self.mouse-x - last-x) / 1px,
                                     (self.mouse-y - last-y) / 1px);
                        last-x = self.mouse-x;
                        last-y = self.mouse-y;
                    }
                    double-clicked => { root.map-zoom(1); }
                }
            }

            // Placeholder until the platform has a map renderer.
            if !root.map-available : VerticalLayout {
                alignment: center;
                spacing: 12px;
                Rectangle {
                    height: 18px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Rectangle { width: 18px; height: 18px; background: Palette.yellow; }
                        Rectangle { width: 18px; height: 18px; background: Palette.red; }
                        Rectangle { width: 18px; height: 18px; background: Palette.blue; }
                    }
                }
                Text {
                    text: "MAP";
                    color: Palette.paper;
                    font-size: 28px;
                    font-weight: 900;
                    letter-spacing: 4px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "RENDERER PORT IN PROGRESS";
                    color: Palette.mute;
                    font-size: 12px;
                    font-weight: 700;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                }
            }

            // Rider position marker: map camera is centered on the rider.
            if root.map-available : Rectangle {
                width: 18px;
                height: 18px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Palette.red;
                border-width: 3px;
                border-color: Palette.paper;
            }

            // Live ride chip while riding.
            if root.map-available && root.ride-state != 0 : Rectangle {
                x: 8px;
                y: 8px;
                width: chip.preferred-width + 24px;
                height: 44px;
                background: Palette.ink;
                chip := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "\{Math.round(root.speed)} km/h";
                        color: Palette.yellow;
                        font-size: 16px;
                        font-weight: 900;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "\{root.distance} km";
                        color: Palette.paper;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            // Zoom controls.
            if root.map-available : VerticalLayout {
                x: parent.width - 56px;
                y: parent.height - 116px;
                width: 48px;
                height: 100px;
                spacing: 4px;
                Rectangle {
                    background: Palette.ink;
                    TouchArea { clicked => { root.map-zoom(1); } }
                    Text {
                        text: "+";
                        color: Palette.paper;
                        font-size: 24px;
                        font-weight: 900;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    background: Palette.ink;
                    TouchArea { clicked => { root.map-zoom(-1); } }
                    Text {
                        text: "−";
                        color: Palette.paper;
                        font-size: 24px;
                        font-weight: 900;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Attribution.
            if root.map-available : Text {
                x: 8px;
                y: parent.height - 20px;
                text: "© MapLibre  © OpenStreetMap";
                color: Palette.mute;
                font-size: 10px;
            }
        }

        // ================= HISTORY =================
        if root.screen == 2 : VerticalLayout {
            vertical-stretch: 1;

            // header
            Rectangle {
                height: 76px;
                background: Palette.ink;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: start;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        background: Palette.red;
                    }
                    Text {
                        text: "RIDES";
                        color: Palette.paper;
                        font-size: 28px;
                        font-weight: 900;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.sessions.length;
                        color: Palette.mute;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            if root.sessions.length == 0 : Rectangle {
                vertical-stretch: 1;
                background: Palette.ink;
                Text {
                    text: "NO RIDES YET";
                    color: Palette.mute;
                    font-size: 16px;
                    font-weight: 700;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.sessions.length > 0 : ListView {
                vertical-stretch: 1;
                for s[i] in root.sessions : Rectangle {
                    height: root.selected-session == i ? 112px : 86px;
                    background: Palette.ink;
                    Rectangle {
                        x: 4px;
                        y: 2px;
                        width: parent.width - 8px;
                        height: parent.height - 4px;
                        background: Palette.ash;
                        TouchArea {
                            clicked => {
                                root.selected-session =
                                    root.selected-session == i ? -1 : i;
                            }
                        }
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 12px;
                                // Bauhaus marker: primary colors cycling by row
                                Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    y: 6px;
                                    background: Math.mod(i, 3) == 0 ? Palette.yellow
                                              : Math.mod(i, 3) == 1 ? Palette.red
                                              : Palette.blue;
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: s.date;
                                        color: Palette.mute;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 1px;
                                    }
                                    Text {
                                        text: "\{s.dist} km";
                                        color: Palette.paper;
                                        font-size: 24px;
                                        font-weight: 900;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: s.time;
                                        color: Palette.paper;
                                        font-size: 16px;
                                        font-weight: 900;
                                        horizontal-alignment: right;
                                    }
                                    Text {
                                        text: "AVG \{s.avg} km/h";
                                        color: Palette.mute;
                                        font-size: 12px;
                                        font-weight: 700;
                                        horizontal-alignment: right;
                                    }
                                }
                            }
                            if root.selected-session == i : HorizontalLayout {
                                spacing: 16px;
                                Text {
                                    text: "MAX \{s.max} km/h";
                                    color: Palette.yellow;
                                    font-size: 12px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "CAD \{s.cadence} rpm";
                                    color: Palette.blue;
                                    font-size: 12px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: "HR \{s.hr} bpm";
                                    color: Palette.red;
                                    font-size: 12px;
                                    font-weight: 700;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- Tab bar: RIDE | MAP | HISTORY ----
        HorizontalLayout {
            height: 52px;
            TabItem {
                label: "RIDE";
                active: root.screen == 0;
                pressed => { root.screen = 0; }
            }
            TabItem {
                label: "MAP";
                active: root.screen == 1;
                pressed => { root.screen = 1; }
            }
            TabItem {
                label: "HISTORY";
                active: root.screen == 2;
                pressed => { root.screen = 2; }
            }
        }

        // gesture/nav-bar inset: dark strip so the system pill stays visible
        // and you can swipe/tap back to the home screen.
        Rectangle {
            height: root.bottom-inset;
            background: Palette.ink;
        }
    }
}
