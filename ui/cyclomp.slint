// cyclomp — Nostromo-class console UI (Alien '79 / MU-TH-UR 6000 aesthetic).
// Shared UI: renders on desktop (C++ preview) and Android (C++ NDK / Slint
// android-activity). The C++ contract (properties, callbacks, structs) is
// identical to the previous Bauhaus skin — only the visual layer changed.

import { ListView } from "std-widgets.slint";

// ---- CRT phosphor palette ----
global Palette {
    out property <color> ink: #030503;     // dead CRT glass
    out property <color> phos: #4dff70;    // green phosphor
    out property <color> dim: #2f7a42;     // faded phosphor
    out property <color> amber: #ffb000;   // amber data channel
    out property <color> red: #ff3b2f;     // alert
    out property <color> cyan: #23b5aa;    // secondary channel
    out property <color> panel: #060d07;   // panel fill
    out property <color> line: #1b4527;    // frame lines
}

// A finished ride, provided by C++ (newest first).
export struct SessionRow {
    date: string,     // "07 SEP 14:32"
    dist: string,     // km, one decimal
    time: string,     // moving time mm:ss
    avg: string,      // km/h
    max: string,      // km/h
    cadence: string,  // rpm
    hr: string,       // bpm
}

// Thin-framed console panel with a caption riding the top border.
component TermPanel inherits Rectangle {
    in property <string> caption;
    background: Palette.panel;
    border-width: 1px;
    border-color: Palette.line;
    if root.caption != "" : Rectangle {
        x: 10px;
        y: -6px;
        width: cap.preferred-width + 12px;
        height: 12px;
        background: Palette.ink;
        cap := Text {
            width: 100%;
            height: 100%;
            text: root.caption;
            color: Palette.dim;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 2px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Outlined console button; fills with its tint while pressed (or `filled`).
component TermButton inherits Rectangle {
    in property <string> label;
    in property <color> tint: Palette.phos;
    in property <bool> filled: false;
    in property <length> label-size: 15px;
    callback pressed();
    border-width: 1px;
    border-color: root.tint;
    background: touch.pressed || root.filled ? root.tint : transparent;
    touch := TouchArea { clicked => { root.pressed(); } }
    Text {
        text: root.label;
        color: touch.pressed || root.filled ? Palette.ink : root.tint;
        font-size: root.label-size;
        font-weight: 900;
        letter-spacing: 2px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Framed close button with an SVG X glyph (the text "×" renders poorly).
component CloseButton inherits Rectangle {
    callback pressed();
    background: Palette.ink;
    border-width: 1px;
    border-color: touch.pressed ? Palette.phos : Palette.line;
    touch := TouchArea { clicked => { root.pressed(); } }
    Path {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: touch.pressed ? Palette.phos : Palette.dim;
        commands: "M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z";
    }
}

// One telemetry cell: dim label over a big phosphor value.
component MetricCell inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <color> accent: Palette.phos;
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text {
            text: root.label;
            color: Palette.dim;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 4px;
            Text {
                text: root.value;
                color: root.accent;
                font-size: 30px;
                font-weight: 900;
            }
            Text {
                text: root.unit;
                color: Palette.dim;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: bottom;
            }
        }
    }
}

// Console header: ship line + screen title + blinking cursor on the left,
// two status lines (GPS / nav) on the right. Replaces the old amber strip.
// Console header, segmented into framed module boxes so each screen reads
// like a system mode panel: ship line, title module, then status modules
// with square indicator lamps.
component ConsoleHeader inherits Rectangle {
    in property <string> title;
    in property <string> status;    // amber module (GPS / count)
    in property <string> status2;   // dim module (detail line)
    height: 88px;
    background: Palette.ink;
    VerticalLayout {
        VerticalLayout {
            padding-left: 12px;
            padding-right: 64px; // clear of the sticky gear button
            padding-top: 8px;
            spacing: 5px;
            // Title module.
            Rectangle {
                height: 38px;
                background: Palette.panel;
                border-width: 1px;
                border-color: Palette.line;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;
                        background: Palette.phos;
                    }
                    Text {
                        text: root.title;
                        color: Palette.phos;
                        font-size: 20px;
                        font-weight: 900;
                        letter-spacing: 3px;
                        vertical-alignment: center;
                    }
                }
            }
            // Status modules.
            HorizontalLayout {
                height: 26px;
                spacing: 6px;
                Rectangle {
                    width: st.preferred-width + 26px;
                    background: Palette.panel;
                    border-width: 1px;
                    border-color: Palette.line;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        alignment: start;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            y: (parent.height - self.height) / 2;
                            background: Palette.amber;
                        }
                        st := Text {
                            text: root.status;
                            color: Palette.amber;
                            font-size: 11px;
                            font-weight: 900;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: Palette.panel;
                    border-width: 1px;
                    border-color: Palette.line;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        alignment: start;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            y: (parent.height - self.height) / 2;
                            background: Palette.dim;
                        }
                        Text {
                            text: root.status2;
                            color: Palette.dim;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        Rectangle { vertical-stretch: 1; background: Palette.ink; }
        Rectangle { height: 1px; background: Palette.line; }
    }
}

// A tunable parameter row on SETTINGS: label + default hint, amber value,
// DEF (red once modified) and − / + steppers or an ON/OFF toggle.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> default-value;
    in property <bool> stepper: true;
    callback minus();
    callback plus();  // also the toggle action when stepper == false
    callback reset(); // back to this parameter's default
    height: 64px;
    background: Palette.panel;
    border-width: 1px;
    border-color: Palette.line;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                color: Palette.phos;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1px;
            }
            Text {
                text: "DEFAULT \{root.default-value}";
                color: Palette.dim;
                font-size: 9px;
                font-weight: 700;
                letter-spacing: 1px;
            }
        }
        Text {
            text: root.value;
            color: Palette.amber;
            font-size: 22px;
            font-weight: 900;
            vertical-alignment: center;
        }
        // Per-parameter reset: dimmed when already at the default.
        Rectangle {
            width: 44px;
            background: Palette.ink;
            border-width: 1px;
            border-color: root.value == root.default-value ? Palette.line
                                                           : Palette.red;
            TouchArea { clicked => { root.reset(); } }
            Text {
                text: "DEF";
                color: root.value == root.default-value ? Palette.dim
                                                        : Palette.red;
                font-size: 10px;
                font-weight: 900;
                letter-spacing: 1px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if root.stepper : TermButton {
            width: 44px;
            label: "−";
            label-size: 20px;
            pressed => { root.minus(); }
        }
        if root.stepper : TermButton {
            width: 44px;
            label: "+";
            label-size: 20px;
            pressed => { root.plus(); }
        }
        if !root.stepper : TermButton {
            width: 92px;
            label: root.value == "ON" ? "DISABLE" : "ENABLE";
            label-size: 11px;
            tint: root.value == "ON" ? Palette.amber : Palette.phos;
            filled: root.value == "ON";
            pressed => { root.plus(); }
        }
    }
}

// Bottom command bar item: inverted phosphor block when active.
component TabItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback pressed();
    background: root.active ? Palette.phos : Palette.ink;
    TouchArea { clicked => { root.pressed(); } }
    Text {
        text: root.label;
        color: root.active ? Palette.ink : Palette.dim;
        font-size: 13px;
        font-weight: 900;
        letter-spacing: 3px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "cyclomp";
    background: Palette.ink;
    default-font-size: 15px;
    preferred-width: 400px;
    preferred-height: 860px;

    // ---- Live ride state (driven from C++) ----
    in-out property <float> speed: 0;        // km/h
    in-out property <string> distance: "0.0"; // km
    in-out property <string> ride-time: "00:00";
    in-out property <float> avg-speed: 0;
    in-out property <int> cadence: 0;         // rpm
    in-out property <int> heart-rate: 0;      // bpm
    in-out property <int> hr-zone: 0;         // 1..5
    in-out property <string> nav-distance: "400 m";
    in-out property <string> nav-instruction: "Turn right — Elm St";

    // Session lifecycle: 0 = idle, 1 = running, 2 = paused.
    in-out property <int> ride-state: 0;

    // Saved rides, newest first (C++ owns the model).
    in property <[SessionRow]> sessions;

    // 0 = live dashboard, 1 = map, 2 = history, 3 = detail, 4 = settings.
    in-out property <int> screen: 0;
    in-out property <int> selected-session: -1;
    // Infographics for the selected session, generated by C++ as SVG
    // command strings (300x70 sparkline viewbox, 300x120 track viewbox).
    in property <string> sel-speed-path;
    in property <string> sel-track-path;
    in property <string> sel-elev-path;
    in property <string> sel-elev-label: "ELEV +0 m";
    // Live elevation HUD on the MAP screen while riding (160x60 viewbox).
    in property <string> live-elev-path;
    in property <string> live-elev-label: "ELEV +0 m";
    callback select-session(int); // opens the ride-detail page (screen 3)

    // ---- Ride-detail page (screen 3) ----
    in-out property <int> detail-tab: 0;          // 0 = TRACK, 1 = MAP
    in-out property <bool> replay-playing: false; // driven by C++
    in property <float> replay-progress: 0.0;     // 0..1
    in property <string> replay-speed-label: "30×";
    callback detail-back();
    callback detail-map-shown();  // MAP tab opened: fit camera to the track
    callback replay-toggle();
    callback replay-speed-cycle();

    // ---- Map (rendered off-screen by MapLibre; C++ pushes RGBA frames) ----
    in property <image> map-frame;
    in property <bool> map-available: false;
    // Rider marker, projected by C++ onto the rendered frame: offsets from
    // the frame centre as a fraction of its width/height. The frame's own
    // aspect ratio is needed to undo `image-fit: cover`. Defaults put the
    // marker dead centre, which is where the desktop path keeps the rider.
    in property <float> marker-nx: 0;
    in property <float> marker-ny: 0;
    in property <float> frame-aspect: 0.6667;
    in property <bool> marker-valid: true;
    // Camera locked onto the rider (released by pan/pinch, retaken by LOCATE).
    in property <bool> map-following: true;
    // Heading-up mode: the map rotates so the bike's course points up.
    in property <bool> map-heading-up: false;
    callback map-heading-toggle();

    // ---- Settings (screen 4, opened by the sticky gear button) ----
    // Value strings are owned by C++ (clamp + persist happen there).
    in property <string> set-zoom-value: "15";
    in property <string> set-heading-speed-value: "7";
    in property <string> set-bearing-delta-value: "3";
    in property <string> set-tunnel-base-value: "0.3";
    in property <string> set-tunnel-cap-value: "1.0";
    in property <string> set-tunnel-fps-value: "30";
    in property <string> set-tunnel-on-value: "ON";
    in property <string> set-compass-rate-value: "0.5";
    in property <string> set-mock-value: "OFF";
    // Numeric tunnel parameters for the dashboard animation.
    in property <float> tunnel-base: 0.3;   // cycles/s at rest
    in property <float> tunnel-cap: 1.0;    // cycles/s ceiling
    in property <float> tunnel-fps: 30;     // animation tick rate
    in property <bool> tunnel-enabled: true;
    // id: 0 follow zoom, 1 heading speed, 2 bearing step, 3 mock ride.
    // dir: -1 / +1 (ignored for the mock toggle); 0 = reset to default.
    callback setting-adjust(int, int);
    callback settings-reset();
    // Where the gear was pressed, so × returns there.
    in-out property <int> prev-screen: 0;

    callback toggle-ride();  // idle->start, running->pause, paused->resume
    callback stop-ride();    // finalize + save session
    callback map-zoom(int);  // +1 / -1 zoom step
    callback map-locate();   // recentre on the rider and relock the camera
    callback map-pan(float, float);          // one-finger drag delta (px)
    callback map-pinch-begin();
    // Fired once when the pinch ends: total scale + the locked anchor (px).
    callback map-pinch-commit(float, float, float);

    // Live pinch preview: the already-rendered frame is scaled visually
    // around the locked anchor (pure GPU, 60fps); mbgl renders once on
    // commit and C++ resets the preview when that sharp frame arrives.
    in-out property <float> map-preview-scale: 1.0;
    in-out property <length> map-pinch-ax: 0px;
    in-out property <length> map-pinch-ay: 0px;

    property <color> hr-color: root.hr-zone >= 4 ? Palette.red
                             : root.hr-zone == 3 ? Palette.amber
                             : Palette.phos;

    // Safe-area insets: system status bar (top) and gesture/nav bar (bottom)
    // get their own dark strips so they stay visible over the black UI.
    in-out property <length> top-inset: 44px;
    in-out property <length> bottom-inset: 40px;

    VerticalLayout {
        // status-bar inset
        Rectangle {
            height: root.top-inset;
            background: Palette.ink;
        }

        // ================= DASHBOARD =================
        if root.screen == 0 : VerticalLayout {
            vertical-stretch: 1;
            ConsoleHeader {
                title: "RIDE CONTROL";
                status: root.nav-distance;
                status2: root.nav-instruction;
            }

            // ---- Velocity readout ----
            Rectangle {
                vertical-stretch: 1;
                background: Palette.ink;
                clip: true;

                // Wireframe tunnel while the ride runs: concentric squares
                // fly outward (quadratic growth = perspective), rate scales
                // with speed. Drawn before the readout, so it sits behind.
                if root.ride-state == 1 && root.tunnel-enabled : tunnel := Rectangle {
                    width: 100%;
                    height: 100%;
                    // Tunnel rate follows the rider, capped so the motion
                    // stays calm at speed; base/cap/fps and the on/off
                    // switch are SYSTEM PARAMETERS. The phase is integrated
                    // on a Timer — multiplying a running clock by a changing
                    // rate would make it jump at every speed update.
                    property <float> phase: 0;
                    Timer {
                        interval: (1000 / Math.max(root.tunnel-fps, 1)) * 1ms;
                        running: true;
                        triggered => {
                            tunnel.phase = Math.mod(
                                tunnel.phase + (1.0 / Math.max(root.tunnel-fps, 1)) *
                                Math.clamp(root.tunnel-base + root.speed / 50.0,
                                           root.tunnel-base, root.tunnel-cap),
                                1.0);
                        }
                    }
                    for i in [0, 1, 2, 3, 4, 5] : Rectangle {
                        property <float> p: Math.mod(tunnel.phase + i / 6.0, 1.0);
                        width: parent.width * (0.06 + 1.1 * self.p * self.p);
                        height: parent.height * (0.06 + 1.1 * self.p * self.p);
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        background: transparent;
                        border-width: self.p > 0.7 ? 4px : self.p > 0.35 ? 3px : 2px;
                        border-color: self.p > 0.5 ? Palette.phos : Palette.dim;
                        opacity: 0.25 + 0.65 * self.p;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: root.ride-state == 2 ? "** SYSTEM HOLD **"
                                                   : "GROUND VELOCITY — KM/H";
                        color: root.ride-state == 2 ? Palette.amber : Palette.dim;
                        font-size: 12px;
                        font-weight: 700;
                        letter-spacing: 3px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: Math.round(root.speed);
                        color: root.ride-state == 2 ? Palette.dim : Palette.phos;
                        font-size: 140px;
                        font-weight: 900;
                        horizontal-alignment: center;
                    }
                }
            }

            // ---- Telemetry panel ----
            TermPanel {
                caption: "TELEMETRY";
                height: 78px;
                HorizontalLayout {
                    MetricCell {
                        horizontal-stretch: 1;
                        label: "DIST";
                        value: root.distance;
                        unit: "KM";
                        accent: Palette.amber;
                    }
                    Rectangle { width: 1px; background: Palette.line; }
                    MetricCell {
                        horizontal-stretch: 1;
                        label: "TIME";
                        value: root.ride-time;
                        unit: "";
                    }
                    Rectangle { width: 1px; background: Palette.line; }
                    MetricCell {
                        horizontal-stretch: 1;
                        label: "AVG";
                        value: Math.round(root.avg-speed);
                        unit: "KM/H";
                    }
                }
            }

            Rectangle { height: 10px; background: Palette.ink; }

            // ---- Bio / drive sensors ----
            TermPanel {
                caption: "BIO // DRIVE";
                height: 78px;
                HorizontalLayout {
                    MetricCell {
                        horizontal-stretch: 1;
                        label: "CADENCE";
                        // Negative = no such sensor on this source (real GPS).
                        value: root.cadence < 0 ? "--" : root.cadence;
                        unit: "RPM";
                        accent: Palette.cyan;
                    }
                    Rectangle { width: 1px; background: Palette.line; }
                    MetricCell {
                        horizontal-stretch: 1;
                        label: root.hr-zone > 0 ? "HEART  Z\{root.hr-zone}" : "HEART";
                        value: root.heart-rate < 0 ? "--" : root.heart-rate;
                        unit: "BPM";
                        accent: root.hr-color;
                    }
                }
            }

            Rectangle { height: 10px; background: Palette.ink; }

            // ---- Ride controls: START / PAUSE+STOP / RESUME+STOP ----
            HorizontalLayout {
                height: 58px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                if root.ride-state == 0 : TermButton {
                    horizontal-stretch: 1;
                    label: "ENGAGE RIDE";
                    pressed => { root.toggle-ride(); }
                }
                if root.ride-state != 0 : TermButton {
                    horizontal-stretch: 1;
                    label: root.ride-state == 1 ? "HOLD" : "RESUME";
                    tint: root.ride-state == 1 ? Palette.amber : Palette.phos;
                    pressed => { root.toggle-ride(); }
                }
                if root.ride-state != 0 : TermButton {
                    horizontal-stretch: 1;
                    label: "TERMINATE";
                    tint: Palette.red;
                    pressed => { root.stop-ride(); }
                }
            }
            Rectangle { height: 8px; background: Palette.ink; }
        }

        // ================= MAP =================
        if root.screen == 1 : Rectangle {
            vertical-stretch: 1;
            background: Palette.ink;
            clip: true; // the pinch preview scales the frame past the edges

            if root.map-available : Image {
                // Scale around the pinch anchor: x' = A*(1-s).
                x: root.map-pinch-ax * (1 - root.map-preview-scale);
                y: root.map-pinch-ay * (1 - root.map-preview-scale);
                width: parent.width * root.map-preview-scale;
                height: parent.height * root.map-preview-scale;
                source: root.map-frame;
                image-fit: cover;
            }

            // Gestures: one-finger pan, two-finger pinch zoom, double-tap
            // zoom-in. The control buttons are declared later, so they stay
            // on top and remain clickable. During the pinch only the visual
            // preview moves; mbgl renders once on commit.
            if root.map-available : gest := ScaleRotateGestureHandler {
                property <float> last-scale: 1.0;
                started => {
                    root.map-pinch-ax = self.center.x;
                    root.map-pinch-ay = self.center.y;
                    root.map-preview-scale = 1.0;
                    self.last-scale = 1.0;
                    root.map-pinch-begin();
                }
                updated => {
                    self.last-scale = self.scale;
                    root.map-preview-scale = self.scale;
                }
                ended => {
                    root.map-pinch-commit(self.last-scale,
                                          root.map-pinch-ax / 1px,
                                          root.map-pinch-ay / 1px);
                }
                cancelled => {
                    root.map-pinch-commit(self.last-scale,
                                          root.map-pinch-ax / 1px,
                                          root.map-pinch-ay / 1px);
                }
                TouchArea {
                    property <length> last-x;
                    property <length> last-y;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            last-x = self.mouse-x;
                            last-y = self.mouse-y;
                        }
                    }
                    moved => {
                        // Suppress the one-finger pan while pinching.
                        if (!gest.active) {
                            root.map-pan((self.mouse-x - last-x) / 1px,
                                         (self.mouse-y - last-y) / 1px);
                        }
                        last-x = self.mouse-x;
                        last-y = self.mouse-y;
                    }
                    double-clicked => { root.map-zoom(1); }
                }
            }

            // Placeholder until the platform has a map renderer.
            if !root.map-available : VerticalLayout {
                alignment: center;
                spacing: 10px;
                Text {
                    text: "MAP SUBSYSTEM";
                    color: Palette.phos;
                    font-size: 24px;
                    font-weight: 900;
                    letter-spacing: 4px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "RENDERER OFFLINE — PORT IN PROGRESS";
                    color: Palette.dim;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                }
            }

            // Rider position marker. The frame is drawn with `image-fit:
            // cover`, so it is scaled by whichever axis has to fill: the
            // same factor is applied to the projected offset here.
            // Styled as a motion-tracker contact: phosphor ring + dot.
            if root.map-available && root.marker-valid : Rectangle {
                width: 38px;
                height: 38px;
                x: (parent.width - self.width) / 2 + root.marker-nx *
                   max(parent.width, parent.height * root.frame-aspect);
                y: (parent.height - self.height) / 2 + root.marker-ny *
                   max(parent.width / root.frame-aspect, parent.height);

                // Soft halo, so the contact survives a busy map.
                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: self.width / 2;
                    background: #4dff7038;
                }
                Rectangle {
                    width: 26px;
                    height: 26px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: self.width / 2;
                    border-width: 2px;
                    border-color: Palette.phos;
                    background: #03050366;
                }
                // Centre dot — alert red while the ride is recording.
                Rectangle {
                    width: 10px;
                    height: 10px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: root.ride-state == 1 ? Palette.red : Palette.phos;
                }
            }

            // Live ride readout while riding.
            if root.map-available && root.ride-state != 0 : Rectangle {
                x: 8px;
                y: 8px;
                width: chip.preferred-width + 24px;
                height: 40px;
                background: Palette.ink;
                border-width: 1px;
                border-color: Palette.line;
                chip := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    alignment: start;
                    Text {
                        text: "V \{Math.round(root.speed)} KM/H";
                        color: Palette.amber;
                        font-size: 14px;
                        font-weight: 900;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "D \{root.distance} KM";
                        color: Palette.phos;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            // Map controls: compass, locate, then zoom.
            if root.map-available : VerticalLayout {
                x: parent.width - 56px;
                y: parent.height - 224px;
                width: 48px;
                height: 208px;
                spacing: 4px;
                // COMPASS: toggle north-up ("N") vs heading-up (SVG course
                // arrow, amber). No unicode arrows — tofu in bundled font.
                Rectangle {
                    background: Palette.ink;
                    border-width: 1px;
                    border-color: root.map-heading-up ? Palette.amber : Palette.line;
                    TouchArea { clicked => { root.map-heading-toggle(); } }
                    if !root.map-heading-up : Text {
                        text: "N";
                        color: Palette.phos;
                        font-size: 18px;
                        font-weight: 900;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if root.map-heading-up : Path {
                        width: 20px;
                        height: 20px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        fill: Palette.amber;
                        commands: "M12 2 4.5 20.29l.71.71L12 18l6.79 3 .71-.71z";
                    }
                }
                // LOCATE: recentre on the rider and relock the camera. Turns
                // amber while the camera is following.
                Rectangle {
                    background: Palette.ink;
                    border-width: 1px;
                    border-color: root.map-following ? Palette.amber : Palette.line;
                    TouchArea { clicked => { root.map-locate(); } }
                    property <color> tint: root.map-following ? Palette.amber
                                                              : Palette.phos;
                    // Crosshair: ring, centre dot, four ticks.
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        border-width: 2px;
                        border-color: parent.tint;
                    }
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        background: parent.tint;
                    }
                    Rectangle {
                        width: 2px; height: 6px;
                        x: (parent.width - self.width) / 2;
                        y: parent.height / 2 - 15px;
                        background: parent.tint;
                    }
                    Rectangle {
                        width: 2px; height: 6px;
                        x: (parent.width - self.width) / 2;
                        y: parent.height / 2 + 9px;
                        background: parent.tint;
                    }
                    Rectangle {
                        width: 6px; height: 2px;
                        x: parent.width / 2 - 15px;
                        y: (parent.height - self.height) / 2;
                        background: parent.tint;
                    }
                    Rectangle {
                        width: 6px; height: 2px;
                        x: parent.width / 2 + 9px;
                        y: (parent.height - self.height) / 2;
                        background: parent.tint;
                    }
                }
                Rectangle {
                    background: Palette.ink;
                    border-width: 1px;
                    border-color: Palette.line;
                    TouchArea { clicked => { root.map-zoom(1); } }
                    Text {
                        text: "+";
                        color: Palette.phos;
                        font-size: 24px;
                        font-weight: 900;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    background: Palette.ink;
                    border-width: 1px;
                    border-color: Palette.line;
                    TouchArea { clicked => { root.map-zoom(-1); } }
                    Text {
                        text: "−";
                        color: Palette.phos;
                        font-size: 24px;
                        font-weight: 900;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Live elevation HUD (bottom-left, above the attribution).
            if root.map-available && root.ride-state != 0
               && root.live-elev-path != "" : Rectangle {
                x: 8px;
                y: parent.height - 116px;
                width: 190px;
                height: 84px;
                background: Palette.ink;
                border-width: 1px;
                border-color: Palette.line;
                Text {
                    x: 8px;
                    y: 6px;
                    text: root.live-elev-label;
                    color: Palette.dim;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 1px;
                }
                Path {
                    x: 8px;
                    y: 22px;
                    width: parent.width - 16px;
                    height: parent.height - 30px;
                    commands: root.live-elev-path;
                    stroke: Palette.amber;
                    stroke-width: 2px;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 160;
                    viewbox-height: 60;
                }
            }

            // Attribution.
            if root.map-available : Text {
                x: 8px;
                y: parent.height - 20px;
                text: "© MapLibre  © OpenStreetMap";
                color: Palette.dim;
                font-size: 10px;
            }
        }

        // ================= LOG (history) =================
        if root.screen == 2 : VerticalLayout {
            vertical-stretch: 1;

            ConsoleHeader {
                title: "SORTIE LOG";
                status: "\{root.sessions.length} STORED";
                status2: "FLIGHT RECORDER";
            }

            if root.sessions.length == 0 : Rectangle {
                vertical-stretch: 1;
                background: Palette.ink;
                Text {
                    text: "NO SORTIES ON RECORD";
                    color: Palette.dim;
                    font-size: 14px;
                    font-weight: 700;
                    letter-spacing: 3px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.sessions.length > 0 : ListView {
                vertical-stretch: 1;
                for s[i] in root.sessions : Rectangle {
                    height: 80px;
                    background: Palette.ink;
                    Rectangle {
                        x: 8px;
                        y: 3px;
                        width: parent.width - 16px;
                        height: parent.height - 6px;
                        background: Palette.panel;
                        border-width: 1px;
                        border-color: Palette.line;
                        TouchArea {
                            clicked => { root.select-session(i); }
                        }
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;
                            // Record index, terminal style.
                            Text {
                                text: i < 9 ? "0\{i + 1}" : "\{i + 1}";
                                color: Palette.dim;
                                font-size: 14px;
                                font-weight: 900;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: s.date;
                                    color: Palette.dim;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                }
                                Text {
                                    text: "\{s.dist} KM";
                                    color: Palette.phos;
                                    font-size: 22px;
                                    font-weight: 900;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: s.time;
                                    color: Palette.amber;
                                    font-size: 15px;
                                    font-weight: 900;
                                    horizontal-alignment: right;
                                }
                                Text {
                                    text: "AVG \{s.avg} KM/H";
                                    color: Palette.dim;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ================= SORTIE DETAIL (screen 3) =================
        if root.screen == 3 : detail := VerticalLayout {
            vertical-stretch: 1;
            property <SessionRow> cur: root.sessions[root.selected-session];

            // header: back + date + headline stats
            Rectangle {
                height: 70px;
                background: Palette.ink;
                VerticalLayout {
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 12px;
                        CloseButton {
                            width: 52px;
                            pressed => { root.detail-back(); }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "SORTIE // \{detail.cur.date}";
                                color: Palette.dim;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 1px;
                            }
                            Text {
                                text: "\{detail.cur.dist} KM";
                                color: Palette.phos;
                                font-size: 24px;
                                font-weight: 900;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: detail.cur.time;
                                color: Palette.amber;
                                font-size: 15px;
                                font-weight: 900;
                                horizontal-alignment: right;
                            }
                            Text {
                                text: "AVG \{detail.cur.avg} KM/H";
                                color: Palette.dim;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: right;
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Palette.line; }
                }
            }
            // sensor stats strip
            Rectangle {
                height: 32px;
                background: Palette.ink;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 20px;
                    alignment: start;
                    Text {
                        text: "MAX \{detail.cur.max} KM/H";
                        color: Palette.amber;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "CAD \{detail.cur.cadence} RPM";
                        color: Palette.cyan;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "HR \{detail.cur.hr} BPM";
                        color: Palette.red;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
            // detail tabs
            HorizontalLayout {
                height: 40px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                TermButton {
                    horizontal-stretch: 1;
                    label: "TRACK DATA";
                    label-size: 12px;
                    filled: root.detail-tab == 0;
                    pressed => { root.detail-tab = 0; }
                }
                TermButton {
                    horizontal-stretch: 1;
                    label: "CHART VIEW";
                    label-size: 12px;
                    filled: root.detail-tab == 1;
                    pressed => {
                        root.detail-tab = 1;
                        root.detail-map-shown();
                    }
                }
            }

            // ---- TRACK tab: infographics ----
            if root.detail-tab == 0 : VerticalLayout {
                vertical-stretch: 1;
                padding: 12px;
                spacing: 14px;
                TermPanel {
                    caption: "SPEED";
                    height: 132px;
                    if root.sel-speed-path != "" : Path {
                        x: 10px;
                        y: 12px;
                        width: parent.width - 20px;
                        height: parent.height - 24px;
                        commands: root.sel-speed-path;
                        stroke: Palette.amber;
                        stroke-width: 2px;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 300;
                        viewbox-height: 70;
                    }
                    if root.sel-speed-path == "" : Text {
                        text: "NO DATA";
                        color: Palette.dim;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                TermPanel {
                    caption: root.sel-elev-label;
                    height: 132px;
                    if root.sel-elev-path != "" : Path {
                        x: 10px;
                        y: 12px;
                        width: parent.width - 20px;
                        height: parent.height - 24px;
                        commands: root.sel-elev-path;
                        stroke: Palette.red;
                        stroke-width: 2px;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 300;
                        viewbox-height: 70;
                    }
                    if root.sel-elev-path == "" : Text {
                        text: "NO DATA";
                        color: Palette.dim;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                TermPanel {
                    caption: "TRACK";
                    vertical-stretch: 1;
                    if root.sel-track-path != "" : Path {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        height: parent.height - 16px;
                        commands: root.sel-track-path;
                        stroke: Palette.phos;
                        stroke-width: 2px;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 300;
                        viewbox-height: 120;
                    }
                    if root.sel-track-path == "" : Text {
                        text: "NO TRACK";
                        color: Palette.dim;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // ---- MAP tab: real map + replay ----
            // The map sits inside a framed 12px inset (same rhythm as the
            // TRACK DATA panels) instead of running edge to edge.
            if root.detail-tab == 1 : Rectangle {
                vertical-stretch: 1;
                background: Palette.ink;
                Rectangle {
                    x: 12px;
                    y: 6px;
                    width: parent.width - 24px;
                    height: parent.height - 74px; // room for the replay bar
                    border-width: 1px;
                    border-color: Palette.line;
                    clip: true;
                    if root.map-available : Image {
                        width: 100%;
                        height: 100%;
                        source: root.map-frame;
                        image-fit: cover;
                    }
                    // replay marker (same cover-projection as the MAP screen)
                    if root.map-available && root.marker-valid : Rectangle {
                        width: 26px;
                        height: 26px;
                        x: (parent.width - self.width) / 2 + root.marker-nx *
                           max(parent.width, parent.height * root.frame-aspect);
                        y: (parent.height - self.height) / 2 + root.marker-ny *
                           max(parent.width / root.frame-aspect, parent.height);
                        border-radius: self.width / 2;
                        border-width: 2px;
                        border-color: Palette.phos;
                        background: #03050366;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            border-radius: 5px;
                            background: Palette.red;
                        }
                    }
                    if !root.map-available : Text {
                        text: "REPLAY — ANDROID ONLY";
                        color: Palette.dim;
                        font-size: 12px;
                        font-weight: 700;
                        letter-spacing: 2px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // replay controls
                if root.map-available : Rectangle {
                    x: 12px;
                    y: parent.height - 62px;
                    width: parent.width - 24px;
                    height: 56px;
                    background: Palette.ink;
                    HorizontalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        TermButton {
                            width: 110px;
                            label: root.replay-playing ? "FREEZE" : "REPLAY";
                            label-size: 13px;
                            tint: root.replay-playing ? Palette.red : Palette.phos;
                            pressed => { root.replay-toggle(); }
                        }
                        TermButton {
                            width: 70px;
                            label: root.replay-speed-label;
                            label-size: 13px;
                            tint: Palette.amber;
                            pressed => { root.replay-speed-cycle(); }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: Palette.panel;
                            border-width: 1px;
                            border-color: Palette.line;
                            Rectangle {
                                x: 0;
                                y: 0;
                                height: 100%;
                                width: parent.width * root.replay-progress;
                                background: Palette.phos;
                            }
                        }
                    }
                }
            }
        }

        // ================= SYSTEM PARAMETERS (screen 4) =================
        if root.screen == 4 : VerticalLayout {
            vertical-stretch: 1;

            Rectangle {
                height: 70px;
                background: Palette.ink;
                VerticalLayout {
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 12px;
                        CloseButton {
                            width: 52px;
                            pressed => { root.screen = root.prev-screen; }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "SYSTEM PARAMETERS";
                            color: Palette.phos;
                            font-size: 20px;
                            font-weight: 900;
                            letter-spacing: 2px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { height: 1px; background: Palette.line; }
                }
            }

            // More parameters than fit one screen: scrollable console list.
            Flickable {
                vertical-stretch: 1;
                VerticalLayout {
                padding: 12px;
                spacing: 10px;
                SettingRow {
                    label: "FOLLOW ZOOM";
                    value: root.set-zoom-value;
                    default-value: "15";
                    minus => { root.setting-adjust(0, -1); }
                    plus => { root.setting-adjust(0, 1); }
                    reset => { root.setting-adjust(0, 0); }
                }
                SettingRow {
                    label: "HEADING SPEED  KM/H";
                    value: root.set-heading-speed-value;
                    default-value: "7";
                    minus => { root.setting-adjust(1, -1); }
                    plus => { root.setting-adjust(1, 1); }
                    reset => { root.setting-adjust(1, 0); }
                }
                SettingRow {
                    label: "BEARING STEP  DEG";
                    value: root.set-bearing-delta-value;
                    default-value: "3";
                    minus => { root.setting-adjust(2, -1); }
                    plus => { root.setting-adjust(2, 1); }
                    reset => { root.setting-adjust(2, 0); }
                }
                SettingRow {
                    label: "TUNNEL BASE  CYC/S";
                    value: root.set-tunnel-base-value;
                    default-value: "0.3";
                    minus => { root.setting-adjust(4, -1); }
                    plus => { root.setting-adjust(4, 1); }
                    reset => { root.setting-adjust(4, 0); }
                }
                SettingRow {
                    label: "TUNNEL CAP  CYC/S";
                    value: root.set-tunnel-cap-value;
                    default-value: "1.0";
                    minus => { root.setting-adjust(5, -1); }
                    plus => { root.setting-adjust(5, 1); }
                    reset => { root.setting-adjust(5, 0); }
                }
                SettingRow {
                    label: "COMPASS RATE  S";
                    value: root.set-compass-rate-value;
                    default-value: "0.5";
                    minus => { root.setting-adjust(8, -1); }
                    plus => { root.setting-adjust(8, 1); }
                    reset => { root.setting-adjust(8, 0); }
                }
                SettingRow {
                    label: "TUNNEL FPS";
                    value: root.set-tunnel-fps-value;
                    default-value: "30";
                    minus => { root.setting-adjust(6, -1); }
                    plus => { root.setting-adjust(6, 1); }
                    reset => { root.setting-adjust(6, 0); }
                }
                SettingRow {
                    label: "TUNNEL ANIMATION";
                    value: root.set-tunnel-on-value;
                    default-value: "ON";
                    stepper: false;
                    plus => { root.setting-adjust(7, 1); }
                    reset => { root.setting-adjust(7, 0); }
                }
                SettingRow {
                    label: "MOCK RIDE  (RESTART)";
                    value: root.set-mock-value;
                    default-value: "OFF";
                    stepper: false;
                    plus => { root.setting-adjust(3, 1); }
                    reset => { root.setting-adjust(3, 0); }
                }
                HorizontalLayout {
                    height: 48px;
                    TermButton {
                        label: "RESTORE FACTORY DEFAULTS";
                        label-size: 13px;
                        tint: Palette.red;
                        pressed => { root.settings-reset(); }
                    }
                }
                }
            }
        }

        // ---- Command bar: RIDE | MAP | LOG ----
        Rectangle { height: 1px; background: Palette.line; }
        HorizontalLayout {
            height: 48px;
            TabItem {
                label: "RIDE";
                active: root.screen == 0;
                pressed => { root.screen = 0; }
            }
            Rectangle { width: 1px; background: Palette.line; }
            TabItem {
                label: "MAP";
                active: root.screen == 1;
                pressed => { root.screen = 1; }
            }
            Rectangle { width: 1px; background: Palette.line; }
            TabItem {
                label: "LOG";
                // 3 = a sortie's detail page; 4 (settings) lights no tab
                active: root.screen == 2 || root.screen == 3;
                pressed => { root.screen = 2; }
            }
        }

        // gesture/nav-bar inset: dark strip so the system pill stays visible
        // and you can swipe/tap back to the home screen.
        Rectangle {
            height: root.bottom-inset;
            background: Palette.ink;
        }
    }

    // Sticky settings button, top-right on the three main screens (the
    // detail page keeps its own header, settings shows ×). Proper gear
    // glyph drawn as an SVG Path — no unicode gear, it would render as
    // tofu in the bundled font.
    if root.screen <= 2 : Rectangle {
        x: parent.width - 56px;
        y: root.top-inset + 9px;
        width: 48px;
        height: 48px;
        background: Palette.ink;
        border-width: 1px;
        border-color: Palette.line;
        TouchArea {
            clicked => {
                root.prev-screen = root.screen;
                root.screen = 4;
            }
        }
        Path {
            x: 12px;
            y: 12px;
            width: 24px;
            height: 24px;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: Palette.phos;
            fill-rule: evenodd;
            commands: "M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z";
        }
    }
}
