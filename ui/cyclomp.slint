// cyclomp — Bauhaus bike-computer dashboard (mock)
// Shared UI: renders on desktop (C++ preview) and Android (C++ NDK / Slint android-activity).

import { ListView } from "std-widgets.slint";

// ---- Bauhaus palette ----
global Palette {
    out property <color> ink: #0d0d0d;      // near-black background
    out property <color> paper: #f4f1e9;    // bone white
    out property <color> yellow: #f3c500;
    out property <color> red: #e2231a;
    out property <color> blue: #1457b8;
    out property <color> ash: #2a2a2a;      // panel fill
    out property <color> mute: #8a8a8a;
}

// A finished ride, provided by C++ (newest first).
export struct SessionRow {
    date: string,     // "07 SEP 14:32"
    dist: string,     // km, one decimal
    time: string,     // moving time mm:ss
    avg: string,      // km/h
    max: string,      // km/h
    cadence: string,  // rpm
    hr: string,       // bpm
}

// A metric tile: small label on top, big value, small unit.
component MetricTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <color> accent: Palette.paper;
    background: Palette.ash;
    VerticalLayout {
        padding: 12px;
        spacing: 2px;
        Text {
            text: root.label;
            color: Palette.mute;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 4px;
            Text {
                text: root.value;
                color: root.accent;
                font-size: 34px;
                font-weight: 900;
                vertical-alignment: center;
            }
            Text {
                text: root.unit;
                color: Palette.mute;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: bottom;
            }
        }
    }
}

// Status strip: GPS state on Android, mock nav on desktop.
component NavStrip inherits Rectangle {
    in property <string> instruction;
    in property <string> distance;
    background: Palette.yellow;
    height: 76px;
    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.distance;
                color: Palette.ink;
                font-size: 20px;
                font-weight: 900;
            }
            Text {
                text: root.instruction;
                color: Palette.ink;
                font-size: 13px;
                font-weight: 700;
            }
        }
    }
}

// A bottom tab-bar item with a yellow active indicator.
component TabItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback pressed();
    background: root.active ? Palette.ash : Palette.ink;
    TouchArea {
        clicked => { root.pressed(); }
    }
    VerticalLayout {
        Rectangle {
            height: 4px;
            background: root.active ? Palette.yellow : transparent;
        }
        Text {
            text: root.label;
            color: root.active ? Palette.paper : Palette.mute;
            font-size: 14px;
            font-weight: 900;
            letter-spacing: 2px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A ride/pause/stop control button.
component ControlButton inherits Rectangle {
    in property <string> label;
    in property <color> fill: Palette.blue;
    in property <color> label-color: Palette.paper;
    callback pressed();
    background: touch.pressed ? Palette.ash : root.fill;
    touch := TouchArea {
        clicked => { root.pressed(); }
    }
    Text {
        text: root.label;
        color: root.label-color;
        font-size: 20px;
        font-weight: 900;
        letter-spacing: 2px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "cyclomp";
    background: Palette.ink;
    default-font-size: 15px;
    preferred-width: 400px;
    preferred-height: 860px;

    // ---- Live ride state (driven from C++) ----
    in-out property <float> speed: 0;        // km/h
    in-out property <string> distance: "0.0"; // km
    in-out property <string> ride-time: "00:00";
    in-out property <float> avg-speed: 0;
    in-out property <int> cadence: 0;         // rpm
    in-out property <int> heart-rate: 0;      // bpm
    in-out property <int> hr-zone: 0;         // 1..5
    in-out property <string> nav-distance: "400 m";
    in-out property <string> nav-instruction: "Turn right — Elm St";

    // Session lifecycle: 0 = idle, 1 = running, 2 = paused.
    in-out property <int> ride-state: 0;

    // Saved rides, newest first (C++ owns the model).
    in property <[SessionRow]> sessions;

    // 0 = live dashboard, 1 = map, 2 = history list.
    in-out property <int> screen: 0;
    in-out property <int> selected-session: -1;
    // Infographics for the selected session, generated by C++ as SVG
    // command strings (300x70 sparkline viewbox, 300x120 track viewbox).
    in property <string> sel-speed-path;
    in property <string> sel-track-path;
    callback select-session(int); // opens the ride-detail page (screen 3)

    // ---- Ride-detail page (screen 3) ----
    in-out property <int> detail-tab: 0;          // 0 = TRACK, 1 = MAP
    in-out property <bool> replay-playing: false; // driven by C++
    in property <float> replay-progress: 0.0;     // 0..1
    in property <string> replay-speed-label: "30×";
    callback detail-back();
    callback detail-map-shown();  // MAP tab opened: fit camera to the track
    callback replay-toggle();
    callback replay-speed-cycle();

    // ---- Map (rendered off-screen by MapLibre; C++ pushes RGBA frames) ----
    in property <image> map-frame;
    in property <bool> map-available: false;
    // Rider marker, projected by C++ onto the rendered frame: offsets from
    // the frame centre as a fraction of its width/height. The frame's own
    // aspect ratio is needed to undo `image-fit: cover`. Defaults put the
    // marker dead centre, which is where the desktop path keeps the rider.
    in property <float> marker-nx: 0;
    in property <float> marker-ny: 0;
    in property <float> frame-aspect: 0.6667;
    in property <bool> marker-valid: true;
    // Camera locked onto the rider (released by pan/pinch, retaken by LOCATE).
    in property <bool> map-following: true;

    callback toggle-ride();  // idle->start, running->pause, paused->resume
    callback stop-ride();    // finalize + save session
    callback map-zoom(int);  // +1 / -1 zoom step
    callback map-locate();   // recentre on the rider and relock the camera
    callback map-pan(float, float);          // one-finger drag delta (px)
    callback map-pinch-begin();
    // Fired once when the pinch ends: total scale + the locked anchor (px).
    callback map-pinch-commit(float, float, float);

    // Live pinch preview: the already-rendered frame is scaled visually
    // around the locked anchor (pure GPU, 60fps); mbgl renders once on
    // commit and C++ resets the preview when that sharp frame arrives.
    in-out property <float> map-preview-scale: 1.0;
    in-out property <length> map-pinch-ax: 0px;
    in-out property <length> map-pinch-ay: 0px;

    property <color> hr-color: root.hr-zone >= 4 ? Palette.red
                             : root.hr-zone == 3 ? Palette.yellow
                             : Palette.blue;

    // Safe-area insets: system status bar (top) and gesture/nav bar (bottom)
    // get their own dark strips so they stay visible over the black UI.
    in-out property <length> top-inset: 44px;
    in-out property <length> bottom-inset: 40px;

    VerticalLayout {
        // status-bar inset
        Rectangle {
            height: root.top-inset;
            background: Palette.ink;
        }

        // ================= DASHBOARD =================
        if root.screen == 0 : VerticalLayout {
            vertical-stretch: 1;
            NavStrip {
                instruction: root.nav-instruction;
                distance: root.nav-distance;
            }

            // ---- Speed hero ----
            Rectangle {
                vertical-stretch: 1;
                background: Palette.ink;
                VerticalLayout {
                    alignment: center;
                    spacing: 0px;
                    Text {
                        text: root.ride-state == 2 ? "PAUSED" : "SPEED  km/h";
                        color: root.ride-state == 2 ? Palette.yellow : Palette.mute;
                        font-size: 13px;
                        font-weight: 700;
                        letter-spacing: 2px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: Math.round(root.speed);
                        color: root.ride-state == 2 ? Palette.mute : Palette.paper;
                        font-size: 150px;
                        font-weight: 900;
                        horizontal-alignment: center;
                    }
                    // Bauhaus accent bar under the number
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            height: 8px;
                            width: 180px;
                            background: Palette.red;
                        }
                    }
                }
            }

            // ---- Core ride metrics row ----
            HorizontalLayout {
                spacing: 4px;
                padding-left: 4px;
                padding-right: 4px;
                MetricTile {
                    horizontal-stretch: 1;
                    label: "DIST";
                    value: root.distance;
                    unit: "km";
                    accent: Palette.yellow;
                }
                MetricTile {
                    horizontal-stretch: 1;
                    label: "TIME";
                    value: root.ride-time;
                    unit: "";
                    accent: Palette.paper;
                }
                MetricTile {
                    horizontal-stretch: 1;
                    label: "AVG";
                    value: Math.round(root.avg-speed);
                    unit: "km/h";
                    accent: Palette.paper;
                }
            }

            // ---- Cadence + heart rate ----
            HorizontalLayout {
                spacing: 4px;
                padding: 4px;
                MetricTile {
                    horizontal-stretch: 1;
                    label: "CADENCE";
                    // Negative = no such sensor on this source (real GPS).
                    value: root.cadence < 0 ? "--" : root.cadence;
                    unit: "rpm";
                    accent: Palette.blue;
                }
                MetricTile {
                    horizontal-stretch: 1;
                    label: root.hr-zone > 0 ? "HEART  Z\{root.hr-zone}" : "HEART";
                    value: root.heart-rate < 0 ? "--" : root.heart-rate;
                    unit: "bpm";
                    accent: root.hr-color;
                }
            }

            // ---- Ride controls: START / PAUSE+STOP / RESUME+STOP ----
            HorizontalLayout {
                height: 64px;
                spacing: root.ride-state == 0 ? 0px : 4px;
                if root.ride-state == 0 : ControlButton {
                    horizontal-stretch: 1;
                    label: "START RIDE";
                    fill: Palette.blue;
                    pressed => { root.toggle-ride(); }
                }
                if root.ride-state != 0 : ControlButton {
                    horizontal-stretch: 1;
                    label: root.ride-state == 1 ? "PAUSE" : "RESUME";
                    fill: root.ride-state == 1 ? Palette.yellow : Palette.blue;
                    label-color: root.ride-state == 1 ? Palette.ink : Palette.paper;
                    pressed => { root.toggle-ride(); }
                }
                if root.ride-state != 0 : ControlButton {
                    horizontal-stretch: 1;
                    label: "STOP";
                    fill: Palette.red;
                    pressed => { root.stop-ride(); }
                }
            }
        }

        // ================= MAP =================
        if root.screen == 1 : Rectangle {
            vertical-stretch: 1;
            background: Palette.ink;
            clip: true; // the pinch preview scales the frame past the edges

            if root.map-available : Image {
                // Scale around the pinch anchor: x' = A*(1-s).
                x: root.map-pinch-ax * (1 - root.map-preview-scale);
                y: root.map-pinch-ay * (1 - root.map-preview-scale);
                width: parent.width * root.map-preview-scale;
                height: parent.height * root.map-preview-scale;
                source: root.map-frame;
                image-fit: cover;
            }

            // Gestures: one-finger pan, two-finger pinch zoom, double-tap
            // zoom-in. The zoom buttons are declared later, so they stay on
            // top and remain clickable. During the pinch only the visual
            // preview moves; mbgl renders once on commit.
            if root.map-available : gest := ScaleRotateGestureHandler {
                property <float> last-scale: 1.0;
                started => {
                    root.map-pinch-ax = self.center.x;
                    root.map-pinch-ay = self.center.y;
                    root.map-preview-scale = 1.0;
                    self.last-scale = 1.0;
                    root.map-pinch-begin();
                }
                updated => {
                    self.last-scale = self.scale;
                    root.map-preview-scale = self.scale;
                }
                ended => {
                    root.map-pinch-commit(self.last-scale,
                                          root.map-pinch-ax / 1px,
                                          root.map-pinch-ay / 1px);
                }
                cancelled => {
                    root.map-pinch-commit(self.last-scale,
                                          root.map-pinch-ax / 1px,
                                          root.map-pinch-ay / 1px);
                }
                TouchArea {
                    property <length> last-x;
                    property <length> last-y;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            last-x = self.mouse-x;
                            last-y = self.mouse-y;
                        }
                    }
                    moved => {
                        // Suppress the one-finger pan while pinching.
                        if (!gest.active) {
                            root.map-pan((self.mouse-x - last-x) / 1px,
                                         (self.mouse-y - last-y) / 1px);
                        }
                        last-x = self.mouse-x;
                        last-y = self.mouse-y;
                    }
                    double-clicked => { root.map-zoom(1); }
                }
            }

            // Placeholder until the platform has a map renderer.
            if !root.map-available : VerticalLayout {
                alignment: center;
                spacing: 12px;
                Rectangle {
                    height: 18px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Rectangle { width: 18px; height: 18px; background: Palette.yellow; }
                        Rectangle { width: 18px; height: 18px; background: Palette.red; }
                        Rectangle { width: 18px; height: 18px; background: Palette.blue; }
                    }
                }
                Text {
                    text: "MAP";
                    color: Palette.paper;
                    font-size: 28px;
                    font-weight: 900;
                    letter-spacing: 4px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "RENDERER PORT IN PROGRESS";
                    color: Palette.mute;
                    font-size: 12px;
                    font-weight: 700;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                }
            }

            // Rider position marker. The frame is drawn with `image-fit:
            // cover`, so it is scaled by whichever axis has to fill: the
            // same factor is applied to the projected offset here.
            if root.map-available && root.marker-valid : Rectangle {
                width: 38px;
                height: 38px;
                x: (parent.width - self.width) / 2 + root.marker-nx *
                   max(parent.width, parent.height * root.frame-aspect);
                y: (parent.height - self.height) / 2 + root.marker-ny *
                   max(parent.width / root.frame-aspect, parent.height);

                // Soft halo, so the marker survives a busy map.
                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: self.width / 2;
                    background: #f4f1e947;
                }
                // Bone-white disc: the contrast ring against the tiles.
                Rectangle {
                    width: 26px;
                    height: 26px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: self.width / 2;
                    background: Palette.paper;
                    border-width: 2px;
                    border-color: Palette.ink;
                }
                // Bauhaus square inside the circle — red while the ride is
                // live, ink when it is idle or paused.
                Rectangle {
                    width: 12px;
                    height: 12px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: root.ride-state == 1 ? Palette.red : Palette.ink;
                }
            }

            // Live ride chip while riding.
            if root.map-available && root.ride-state != 0 : Rectangle {
                x: 8px;
                y: 8px;
                width: chip.preferred-width + 24px;
                height: 44px;
                background: Palette.ink;
                chip := HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "\{Math.round(root.speed)} km/h";
                        color: Palette.yellow;
                        font-size: 16px;
                        font-weight: 900;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "\{root.distance} km";
                        color: Palette.paper;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            // Map controls: locate, then zoom.
            if root.map-available : VerticalLayout {
                x: parent.width - 56px;
                y: parent.height - 172px;
                width: 48px;
                height: 156px;
                spacing: 4px;
                // LOCATE: recentre on the rider and relock the camera. Turns
                // yellow while the camera is following.
                Rectangle {
                    background: Palette.ink;
                    TouchArea { clicked => { root.map-locate(); } }
                    property <color> tint: root.map-following ? Palette.yellow
                                                              : Palette.paper;
                    // Crosshair: ring, centre dot, four ticks.
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        border-width: 2px;
                        border-color: parent.tint;
                    }
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 3px;
                        background: parent.tint;
                    }
                    Rectangle {
                        width: 2px; height: 6px;
                        x: (parent.width - self.width) / 2;
                        y: parent.height / 2 - 15px;
                        background: parent.tint;
                    }
                    Rectangle {
                        width: 2px; height: 6px;
                        x: (parent.width - self.width) / 2;
                        y: parent.height / 2 + 9px;
                        background: parent.tint;
                    }
                    Rectangle {
                        width: 6px; height: 2px;
                        x: parent.width / 2 - 15px;
                        y: (parent.height - self.height) / 2;
                        background: parent.tint;
                    }
                    Rectangle {
                        width: 6px; height: 2px;
                        x: parent.width / 2 + 9px;
                        y: (parent.height - self.height) / 2;
                        background: parent.tint;
                    }
                }
                Rectangle {
                    background: Palette.ink;
                    TouchArea { clicked => { root.map-zoom(1); } }
                    Text {
                        text: "+";
                        color: Palette.paper;
                        font-size: 24px;
                        font-weight: 900;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    background: Palette.ink;
                    TouchArea { clicked => { root.map-zoom(-1); } }
                    Text {
                        text: "−";
                        color: Palette.paper;
                        font-size: 24px;
                        font-weight: 900;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Attribution.
            if root.map-available : Text {
                x: 8px;
                y: parent.height - 20px;
                text: "© MapLibre  © OpenStreetMap";
                color: Palette.mute;
                font-size: 10px;
            }
        }

        // ================= HISTORY =================
        if root.screen == 2 : VerticalLayout {
            vertical-stretch: 1;

            // header
            Rectangle {
                height: 76px;
                background: Palette.ink;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: start;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        background: Palette.red;
                    }
                    Text {
                        text: "RIDES";
                        color: Palette.paper;
                        font-size: 28px;
                        font-weight: 900;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.sessions.length;
                        color: Palette.mute;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            if root.sessions.length == 0 : Rectangle {
                vertical-stretch: 1;
                background: Palette.ink;
                Text {
                    text: "NO RIDES YET";
                    color: Palette.mute;
                    font-size: 16px;
                    font-weight: 700;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.sessions.length > 0 : ListView {
                vertical-stretch: 1;
                for s[i] in root.sessions : Rectangle {
                    height: 86px;
                    background: Palette.ink;
                    Rectangle {
                        x: 4px;
                        y: 2px;
                        width: parent.width - 8px;
                        height: parent.height - 4px;
                        background: Palette.ash;
                        TouchArea {
                            clicked => { root.select-session(i); }
                        }
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 12px;
                                // Bauhaus marker: primary colors cycling by row
                                Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    y: 6px;
                                    background: Math.mod(i, 3) == 0 ? Palette.yellow
                                              : Math.mod(i, 3) == 1 ? Palette.red
                                              : Palette.blue;
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: s.date;
                                        color: Palette.mute;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 1px;
                                    }
                                    Text {
                                        text: "\{s.dist} km";
                                        color: Palette.paper;
                                        font-size: 24px;
                                        font-weight: 900;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: s.time;
                                        color: Palette.paper;
                                        font-size: 16px;
                                        font-weight: 900;
                                        horizontal-alignment: right;
                                    }
                                    Text {
                                        text: "AVG \{s.avg} km/h";
                                        color: Palette.mute;
                                        font-size: 12px;
                                        font-weight: 700;
                                        horizontal-alignment: right;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ================= RIDE DETAIL (screen 3) =================
        if root.screen == 3 : detail := VerticalLayout {
            vertical-stretch: 1;
            property <SessionRow> cur: root.sessions[root.selected-session];

            // header: back + date + headline stats
            Rectangle {
                height: 76px;
                background: Palette.ink;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    Rectangle {
                        width: 52px;
                        background: Palette.ash;
                        TouchArea { clicked => { root.detail-back(); } }
                        Text {
                            text: "×";
                            color: Palette.paper;
                            font-size: 24px;
                            font-weight: 900;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: detail.cur.date;
                            color: Palette.mute;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }
                        Text {
                            text: "\{detail.cur.dist} km";
                            color: Palette.paper;
                            font-size: 26px;
                            font-weight: 900;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: detail.cur.time;
                            color: Palette.paper;
                            font-size: 16px;
                            font-weight: 900;
                            horizontal-alignment: right;
                        }
                        Text {
                            text: "AVG \{detail.cur.avg} km/h";
                            color: Palette.mute;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: right;
                        }
                    }
                }
            }
            // sensor stats strip
            Rectangle {
                height: 36px;
                background: Palette.ink;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 20px;
                    alignment: start;
                    Text {
                        text: "MAX \{detail.cur.max} km/h";
                        color: Palette.yellow;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "CAD \{detail.cur.cadence} rpm";
                        color: Palette.blue;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "HR \{detail.cur.hr} bpm";
                        color: Palette.red;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
            // detail tabs
            HorizontalLayout {
                height: 44px;
                TabItem {
                    label: "TRACK";
                    active: root.detail-tab == 0;
                    pressed => { root.detail-tab = 0; }
                }
                TabItem {
                    label: "MAP";
                    active: root.detail-tab == 1;
                    pressed => {
                        root.detail-tab = 1;
                        root.detail-map-shown();
                    }
                }
            }

            // ---- TRACK tab: infographics ----
            if root.detail-tab == 0 : VerticalLayout {
                vertical-stretch: 1;
                padding: 12px;
                spacing: 12px;
                Rectangle {
                    height: 140px;
                    background: Palette.ash;
                    Text {
                        x: 10px;
                        y: 8px;
                        text: "SPEED";
                        color: Palette.mute;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 1px;
                    }
                    if root.sel-speed-path != "" : Path {
                        x: 10px;
                        y: 12px;
                        width: parent.width - 20px;
                        height: parent.height - 24px;
                        commands: root.sel-speed-path;
                        stroke: Palette.yellow;
                        stroke-width: 2px;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 300;
                        viewbox-height: 70;
                    }
                    if root.sel-speed-path == "" : Text {
                        text: "NO DATA";
                        color: Palette.mute;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: Palette.ash;
                    Text {
                        x: 10px;
                        y: 8px;
                        text: "TRACK";
                        color: Palette.mute;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 1px;
                    }
                    if root.sel-track-path != "" : Path {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        height: parent.height - 16px;
                        commands: root.sel-track-path;
                        stroke: Palette.blue;
                        stroke-width: 2px;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 300;
                        viewbox-height: 120;
                    }
                    if root.sel-track-path == "" : Text {
                        text: "NO TRACK";
                        color: Palette.mute;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // ---- MAP tab: real map + replay ----
            if root.detail-tab == 1 : Rectangle {
                vertical-stretch: 1;
                background: Palette.ink;
                clip: true;
                if root.map-available : Image {
                    width: 100%;
                    height: 100%;
                    source: root.map-frame;
                    image-fit: cover;
                }
                // replay marker (same cover-projection as the MAP screen)
                if root.map-available && root.marker-valid : Rectangle {
                    width: 26px;
                    height: 26px;
                    x: (parent.width - self.width) / 2 + root.marker-nx *
                       max(parent.width, parent.height * root.frame-aspect);
                    y: (parent.height - self.height) / 2 + root.marker-ny *
                       max(parent.width / root.frame-aspect, parent.height);
                    border-radius: self.width / 2;
                    background: Palette.paper;
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.width / 2;
                        background: Palette.red;
                    }
                }
                if !root.map-available : Text {
                    text: "REPLAY — ANDROID ONLY";
                    color: Palette.mute;
                    font-size: 13px;
                    font-weight: 700;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                // replay controls
                if root.map-available : Rectangle {
                    y: parent.height - 56px;
                    height: 56px;
                    width: 100%;
                    background: Palette.ink;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        Rectangle {
                            width: 110px;
                            background: root.replay-playing ? Palette.red
                                                            : Palette.blue;
                            TouchArea { clicked => { root.replay-toggle(); } }
                            Text {
                                text: root.replay-playing ? "PAUSE" : "PLAY";
                                color: Palette.paper;
                                font-size: 14px;
                                font-weight: 900;
                                letter-spacing: 1px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            width: 70px;
                            background: Palette.ash;
                            TouchArea { clicked => { root.replay-speed-cycle(); } }
                            Text {
                                text: root.replay-speed-label;
                                color: Palette.paper;
                                font-size: 14px;
                                font-weight: 900;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: Palette.ash;
                            Rectangle {
                                x: 0;
                                y: 0;
                                height: 100%;
                                width: parent.width * root.replay-progress;
                                background: Palette.yellow;
                            }
                        }
                    }
                }
            }
        }

        // ---- Tab bar: RIDE | MAP | HISTORY ----
        HorizontalLayout {
            height: 52px;
            TabItem {
                label: "RIDE";
                active: root.screen == 0;
                pressed => { root.screen = 0; }
            }
            TabItem {
                label: "MAP";
                active: root.screen == 1;
                pressed => { root.screen = 1; }
            }
            TabItem {
                label: "HISTORY";
                active: root.screen >= 2; // 3 = a ride's detail page
                pressed => { root.screen = 2; }
            }
        }

        // gesture/nav-bar inset: dark strip so the system pill stays visible
        // and you can swipe/tap back to the home screen.
        Rectangle {
            height: root.bottom-inset;
            background: Palette.ink;
        }
    }
}
